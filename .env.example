DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=America/Bogota

# SQLite guarda la base local en backend/db.sqlite3.
DJANGO_DB_ENGINE=sqlite3

# Para usar PostgreSQL instalado localmente, cambia DJANGO_DB_ENGINE a postgresql
# y configura estas variables:
# POSTGRES_DB=huellitas
# POSTGRES_USER=huellitas
# POSTGRES_PASSWORD=tu_contraseña
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Factory Method: elige la implementacion concreta sin tocar el dominio
NOTIFICACION_CANAL=consola
POLITICA_TARIFA=estandar

VITE_API_BASE_URL=http://localhost:8000/api
