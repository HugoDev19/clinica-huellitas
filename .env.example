DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=America/Bogota

# En local, SQLite guarda la base en backend/db.sqlite3.
DJANGO_DB_ENGINE=sqlite3

# Para usar PostgreSQL instalado localmente, cambia DJANGO_DB_ENGINE a postgresql
# y configura estas variables:
# POSTGRES_DB=huellitas
# POSTGRES_USER=huellitas
# POSTGRES_PASSWORD=tu_contraseña
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# En Vercel agrega DATABASE_URL desde la integracion PostgreSQL (por ejemplo Neon).
# No guardes una URL real ni credenciales en este archivo ni en Git.
# DATABASE_URL=postgresql://usuario:contraseña@host/base?sslmode=require

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=

# Factory Method: elige la implementacion concreta sin tocar el dominio
NOTIFICACION_CANAL=consola
POLITICA_TARIFA=estandar

VITE_API_BASE_URL=http://localhost:8000/api

DATABASE_URL=postgresql://neondb_owner:npg_MOAlY8Rrvx4z@ep-broad-bread-bcy9p4c8-pooler.c-16.us-east-1.aws.neon.tech/clinica-huellitas?sslmode=require&channel_binding=require
