DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=America/Bogota

# Local development uses SQLite at backend/db.sqlite3.
DJANGO_DB_ENGINE=sqlite3

# For local PostgreSQL, configure POSTGRES_DB, POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_HOST, and POSTGRES_PORT.

# For production, add DATABASE_URL as a secret environment variable in Vercel.
# Never put real database credentials in this file or commit them to Git.

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=

NOTIFICACION_CANAL=consola
POLITICA_TARIFA=estandar

VITE_API_BASE_URL=http://localhost:8000/api
